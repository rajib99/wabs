# ---- Always required ----
DATABASE_URL=postgres://localhost/biyeshadi
TEST_DATABASE_URL=postgres://localhost/biyeshadi_test

# ---- Adapter selection ----
# mock = simulator only. openwa = interim unofficial gateway. whatsapp = official Cloud API.
CHANNEL=mock
# mock is refused on any live channel: it cannot talk to real people.
LLM_PROVIDER=mock       # mock | deepseek
TRANSCRIBER=mock        # mock | groq
EMBEDDER=e5             # e5 | mock
STORAGE=local           # local | r2
LOCAL_STORAGE_DIR=.data/media
LOG_LEVEL=info

# ---- Admin login (Auth.js) ----
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
ADMIN_EMAIL=owner@biyeshadi.live   # used by db:seed to create the owner
ADMIN_PASSWORD=                    # used by db:seed; min 12 chars

# ---- Simulator API (only active when CHANNEL=mock) ----
SIMULATOR_TOKEN=dev-simulator-token

# ---- Inngest ----
INNGEST_DEV=1                       # development only
# INNGEST_BASE_URL=http://inngest:8288
# INNGEST_EVENT_KEY=                # openssl rand -hex 32
# INNGEST_SIGNING_KEY=              # openssl rand -hex 32

# ---- DeepSeek (LLM_PROVIDER=deepseek) ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Groq (TRANSCRIBER=groq) ----
GROQ_API_KEY=

# ---- OpenWA gateway (CHANNEL=openwa): the interim channel ----
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=                     # openssl rand -hex 24
OPENWA_SESSION=biyeshadi
OPENWA_WEBHOOK_SECRET=              # openssl rand -hex 24
OPENWA_WEBHOOK_URL=http://127.0.0.1:3000/api/openwa/webhook

# ---- WhatsApp Cloud API (CHANNEL=whatsapp): uncomment once Meta approves ----
# Steps are in the README under "Switching to the official Cloud API".
# CHANNEL=whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0

# ---- Cloudflare R2 (STORAGE=r2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=biyeshadi-media

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- Docker Compose (production) ----
POSTGRES_PASSWORD=
DOMAIN=biyeshadi.live

# ---- Backups (deploy/backup.sh) ----
R2_BACKUP_BUCKET=biyeshadi-backups

# ---- Self-hosted Inngest (production) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
